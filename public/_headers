# Cloudflare Pages headers for caching and security
#
# HTML caching: a non-zero max-age is necessary but NOT sufficient on Pages -
# the edge keeps answering cf-cache-status: DYNAMIC for documents until a zone
# "Cache Rules" entry marks / as cache-eligible (dashboard-only, cannot be set
# from this repo). Keep the 30 s browser reuse regardless: it lets a back/forward
# or repeated navigation render without a round trip. PSI's mobile LCP swings
# 1.7 s -> 4.3 s purely on that origin round trip (~800 ms from Asia).
/*
  Cache-Control: public, max-age=30, s-maxage=3600, stale-while-revalidate=86400
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; manifest-src 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Content-hashed (see scripts/externalize-script.mjs) -> safe forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed name, behaviour changes only on deploy (Pages purges then), so a day of
# reuse is free - it was the last first-party item in cache-insight.
/router.js
  Cache-Control: public, max-age=86400

/_assets/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, follow

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable
